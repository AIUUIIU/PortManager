<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PortManagerWin.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortManagerWin.ViewModels"
    xmlns:conv="using:PortManagerWin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        </Style>

        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 操作结果提示 ===== -->
        <InfoBar x:Name="Info"
                 Grid.Row="0"
                 Margin="28,10,28,0"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- ===== 页面标题 ===== -->
        <TextBlock Grid.Row="1"
                   Margin="28,0,28,18"
                   Text="{x:Bind Loc.PageTitle, Mode=OneWay}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   TextWrapping="NoWrap" />

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="2" Margin="28,0,28,20" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Width="270"
                            Height="34"
                            QueryIcon="Find"
                            PlaceholderText="{x:Bind Loc.SearchPlaceholder, Mode=OneWay}"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />

            <SelectorBar x:Name="FilterBar"
                         Grid.Column="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem Text="{x:Bind Loc.FilterListening, Mode=OneWay}" Tag="listen" IsSelected="True" />
                <SelectorBarItem Text="{x:Bind Loc.FilterAll, Mode=OneWay}" Tag="all" />
                <SelectorBarItem Text="{x:Bind Loc.FilterEstablished, Mode=OneWay}" Tag="established" />
                <SelectorBarItem Text="{x:Bind Loc.FilterWatched, Mode=OneWay}" Tag="watched" />
            </SelectorBar>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <ToggleSwitch x:Name="AutoSwitch"
                              MinWidth="0"
                              IsOn="True"
                              FontSize="13"
                              OnContent="{x:Bind Loc.AutoRefresh, Mode=OneWay}"
                              OffContent="{x:Bind Loc.AutoRefresh, Mode=OneWay}"
                              Toggled="AutoSwitch_Toggled" />

                <Button x:Name="RefreshButton"
                        Style="{StaticResource ToolbarButton}"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="{x:Bind Loc.RefreshTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>

                <Button x:Name="SettingsButton"
                        Style="{StaticResource ToolbarButton}"
                        ToolTipService.ToolTip="{x:Bind Loc.Settings, Mode=OneWay}">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                    
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 关注端口 ===== -->
        <Grid Grid.Row="3" Margin="28,0,28,18" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind Loc.WatchedSection, Mode=OneWay}"
                           Style="{StaticResource SectionTitle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="WatchInput"
                             Width="112"
                             Height="32"
                             MaxLength="5"
                             PlaceholderText="{x:Bind Loc.AddPortPlaceholder, Mode=OneWay}"
                             KeyDown="WatchInput_KeyDown" />
                    <Button Content="{x:Bind Loc.Add, Mode=OneWay}"
                            Height="32"
                            MinWidth="64"
                            Click="AddWatch_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="WatchScroll"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Watched, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchCardVm">
                            <Border Width="216"
                                    Padding="15,12"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 端口号 + 状态 + 取消关注 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Port}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   VerticalAlignment="Center" />

                                        <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border CornerRadius="10"
                                                    Padding="9,2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{x:Bind IsBusy, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{x:Bind StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </Border>
                                            <Border CornerRadius="10"
                                                    Padding="9,2"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{x:Bind IsBusy, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock Text="{x:Bind StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                        </Grid>

                                        <Button Grid.Column="2"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Margin="6,0,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="4"
                                                Click="Unwatch_Click"
                                                Tag="{x:Bind Port}"
                                                ToolTipService.ToolTip="{x:Bind UnwatchTooltip}">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind InfoText}"
                                               FontSize="13"
                                               FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind IsBusy, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{x:Bind ReleaseText}"
                                                Height="28"
                                                MinWidth="72"
                                                Padding="12,0"
                                                FontSize="13"
                                                Click="ReleasePort_Click"
                                                Tag="{x:Bind Port}"
                                                IsEnabled="{x:Bind CanKill}"
                                                ToolTipService.ToolTip="{x:Bind ReleaseText}" />
                                        <Button Content="{x:Bind DetailsText}"
                                                Height="28"
                                                MinWidth="64"
                                                Padding="12,0"
                                                FontSize="13"
                                                Click="WatchDetail_Click"
                                                Tag="{x:Bind Pid}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- ===== 端口列表 ===== -->
        <Grid Grid.Row="4" Margin="28,0,28,0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Bind Loc.AllPortsSection, Mode=OneWay}"
                       Style="{StaticResource SectionTitle}" />

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 列头 -->
                <Grid Padding="18,8,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind Loc.ColPort, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Loc.ColProto, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Loc.ColLocal, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Loc.ColRemote, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Loc.ColState, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="5" Text="{x:Bind Loc.ColPid, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="6" Text="{x:Bind Loc.ColProcess, Mode=OneWay}" Style="{StaticResource ColumnHeaderText}" />
                    <TextBlock Grid.Column="7"
                               Text="{x:Bind Loc.ColActions, Mode=OneWay}"
                               Style="{StaticResource ColumnHeaderText}"
                               TextAlignment="Right" />
                </Grid>

                <ProgressBar Grid.Row="0"
                             Height="2"
                             IsIndeterminate="True"
                             VerticalAlignment="Bottom"
                             Visibility="{x:Bind Vm.IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- 卡片化列表 -->
                <ListView x:Name="PortList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind Vm.Visible, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="0,4,0,6"
                          CornerRadius="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PortRow">
                            <Grid Padding="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                             Visibility="{x:Bind IsWatched, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{x:Bind Port}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Proto}"
                                           Style="{StaticResource MonoCell}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <TextBlock Grid.Column="2" Text="{x:Bind Local}" Style="{StaticResource MonoCell}" />

                                <TextBlock Grid.Column="3" Text="{x:Bind RemoteDisplay, Mode=OneWay}" Style="{StaticResource MonoCell}" />

                                <Border Grid.Column="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        Padding="7,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind State, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <TextBlock Grid.Column="5" Text="{x:Bind PidText}" Style="{StaticResource MonoCell}" />

                                <TextBlock Grid.Column="6" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource CellText}" />

                                <StackPanel Grid.Column="7"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowIconButton}"
                                            Click="Detail_Click"
                                            Tag="{x:Bind Pid}"
                                            ToolTipService.ToolTip="{x:Bind DetailsText}">
                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource RowIconButton}"
                                            Click="Kill_Click"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind CanKill, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            ToolTipService.ToolTip="{x:Bind KillTooltip}">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE71C;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind Loc.EmptyState, Mode=OneWay}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Grid Grid.Row="5" Margin="28,12,28,14">
            <TextBlock Text="{x:Bind Vm.SummaryText, Mode=OneWay}"
                       FontSize="13.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind Vm.UpdateText, Mode=OneWay}"
                       FontSize="13.5"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
