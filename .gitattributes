# 默认由 Git 自动判断文本文件，并在仓库内统一使用 LF 存储
* text=auto

# Windows 源码与工程文件：检出时使用 CRLF
*.cs       text eol=crlf
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.manifest text eol=crlf
*.appxmanifest text eol=crlf
*.ps1      text eol=crlf

# 文档与配置：统一 LF
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.py       text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制资源，禁止换行转换与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
